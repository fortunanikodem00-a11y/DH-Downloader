[gd_scene load_steps=2 format=3 uid="uid://aether_plugin_browser"]

[sub_resource type="GDScript" id="GDScript_plugin_browser"]
script/source = "extends Control

@onready var url_input: LineEdit = $VBoxContainer/TopBar/UrlInput
@onready var go_btn: Button = $VBoxContainer/TopBar/GoBtn
@onready var status_label: Label = $VBoxContainer/StatusLabel

# Tutaj odwołujemy się do węzła wtyczki WebView / CEF dostarczonego przez plugin
@onready var browser_view = $VBoxContainer/BrowserContainer/WebViewNode 

func _ready() -> void:
	go_btn.pressed.connect(_on_go_pressed)
	url_input.text_submitted.connect(_on_url_submitted)
	
	# Jeśli wtyczka ma sygnał ładowania, podpinamy go tutaj
	# browser_view.url_changed.connect(_on_url_changed)
	
	url_input.text = \"https://www.youtube.com\"
	_load_url(url_input.text)

func _on_go_pressed() -> void:
	_load_url(url_input.text)

func _on_url_submitted(new_text: String) -> void:
	_load_url(new_text)

func _load_url(target_url: String) -> void:
	var url = target_url.strip_edges()
	if not url.begins_with(\"http://\") and not url.begins_with(\"https://\"):
		url = \"https://\" + url
	url_input.text = url
	
	status_label.text = \"Status: Ładowanie przez wtyczkę...\"
	
	# Bezpieczne wywołanie metody ładowania URL z zainstalowanej wtyczki WebView/CEF
	if browser_view and browser_view.has_method(\"load_url\"):
		browser_view.load_url(url)
	elif browser_view and \"url\" in browser_view:
		browser_view.url = url
	else:
		status_label.text = \"Status: Błąd - Sprawdź nazwę węzła wtyczki!\"
"

[node name="AetherPluginBrowser" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_plugin_browser")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="UrlInput" type="LineEdit" parent="VBoxContainer/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Wpisz adres (np. https://www.youtube.com)..."

[node name="GoBtn" type="Button" parent="VBoxContainer/TopBar"]
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
text = "Idź"

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Status: Gotowy"

[node name="BrowserContainer" type="Control" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="WebViewNode" type="Control" parent="VBoxContainer/BrowserContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
