[gd_scene load_steps=2 format=3 uid="uid://aether_browser_app"]

[sub_resource type="GDScript" id="GDScript_browser"]
script/source = "extends Control

@onready var url_input: LineEdit = $VBoxContainer/TopBar/UrlInput
@onready var go_btn: Button = $VBoxContainer/TopBar/GoBtn
@onready var content_text: TextEdit = $VBoxContainer/ContentText
@onready var http_request: HTTPRequest = $HTTPRequest
@onready var status_label: Label = $VBoxContainer/StatusLabel

func _ready() -> void:
	go_btn.pressed.connect(_on_go_pressed)
	url_input.text_submitted.connect(_on_url_submitted)
	http_request.request_completed.connect(_on_request_completed)
	url_input.text = \"https://\"

func _on_go_pressed() -> void:
	_load_url(url_input.text)

func _on_url_submitted(new_text: String) -> void:
	_load_url(new_text)

func _load_url(target_url: String) -> void:
	var url = target_url.strip_edges()
	if not url.begins_with(\"http://\") and not url.begins_with(\"https://\"):
		url = \"https://\" + url
	url_input.text = url
	
	status_label.text = \"Status: Pobieranie z \" + url + \"...\"
	content_text.text = \"Ładowanie zawartości...\"
	
	var err = http_request.request(url)
	if err != OK:
		status_label.text = \"Status: Błąd żądania (Kod: \" + str(err) + \")\"

func _on_request_completed(result: int, response_code: int, headers: PackedStringArray, body: PackedByteArray) -> void:
	if response_code == 200:
		status_label.text = \"Status: Załadowano pomyślnie (200 OK)\"
		content_text.text = body.get_string_from_utf8()
	else:
		status_label.text = \"Status: Błąd HTTP \" + str(response_code)
		content_text.text = \"Nie udało się pobrać zawartości strony.\"
"

[node name="BrowserWindow" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_browser")

[node name="HTTPRequest" type="HTTPRequest" parent="."]

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="UrlInput" type="LineEdit" parent="VBoxContainer/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Wpisz adres strony (np. raw z GitHuba)..."

[node name="GoBtn" type="Button" parent="VBoxContainer/TopBar"]
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
text = "Idź"

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Status: Gotowy"

[node name="ContentText" type="TextEdit" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
editable = false
wrap_mode = 1
