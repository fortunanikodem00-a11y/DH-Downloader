[gd_scene load_steps=2 format=3 uid="uid://aether_gdcef_browser"]

[sub_resource type="GDScript" id="GDScript_gdcef"]
script/source = "extends GDCEF

@onready var url_input: LineEdit = $VBoxContainer/TopBar/UrlInput
@onready var go_btn: Button = $VBoxContainer/TopBar/GoBtn
@onready var browser_texture: TextureRect = $VBoxContainer/BrowserContainer/TextureRect
@onready var status_label: Label = $VBoxContainer/StatusLabel

var browser = null

func _ready() -> void:
	go_btn.pressed.connect(_on_go_pressed)
	url_input.text_submitted.connect(_on_url_submitted)
	
	# 1. Inicjalizacja CEF (wymagana przed utworzeniem przeglądarki)
	var ok = initialize({})
	if not ok:
		status_label.text = \"Status: Błąd inicjalizacji gdCEF!\"
		return
	
	url_input.text = \"https://www.youtube.com\"
	_load_url(url_input.text)

func _on_go_pressed() -> void:
	_load_url(url_input.text)

func _on_url_submitted(new_text: String) -> void:
	_load_url(new_text)

func _load_url(target_url: String) -> void:
	var url = target_url.strip_edges()
	if not url.begins_with(\"http://\") and not url.begins_with(\"https://\"):
		url = \"https://\" + url
	url_input.text = url
	
	status_label.text = \"Status: Ładowanie strony przez gdCEF...\"
	
	# 2. Tworzenie przeglądarki i przypisanie jej do TextureRect
	if browser == null:
		browser = create_browser(url, browser_texture, {})
		if browser:
			browser.set_name(\"aether_browser_view\")
			status_label.text = \"Status: Strona załadowana wewnątrz aplikacji\"
		else:
			status_label.text = \"Status: Nie udało się utworzyć instancji browsera\"
	else:
		# Jeśli przeglądarka już istnieje, wywołujemy nawigację
		if browser.has_method(\"load_url\"):
			browser.load_url(url)
"

[node name="AetherGdCefApp" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_gdcef")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="UrlInput" type="LineEdit" parent="VBoxContainer/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Wpisz adres (np. https://www.youtube.com)..."

[node name="GoBtn" type="Button" parent="VBoxContainer/TopBar"]
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
text = "Idź"

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Status: Inicjalizacja..."

[node name="BrowserContainer" type="Control" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="TextureRect" type="TextureRect" parent="VBoxContainer/BrowserContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 5
