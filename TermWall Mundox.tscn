[gd_scene load_steps=3 format=3 uid="uid://termwall_mundox_zabra_ready"]

[sub_resource type="GDScript" id="GDScript_parser"]
script/source = "extends Node

signal output_produced(text: String)
signal error_produced(text: String)
signal scene_change_requested(scene_path: String)

var registers: Dictionary = {}
var config_data: Dictionary = {
	\"sys_name\": \"TermWall Mundox\",
	\"version\": \"1.0-PurpleCrow\",
	\"password\": \"admin\",
	\"user\": \"root\"
}

const CONFIG_PATH = \"user://termwall_config.json\"

func _ready() -> void:
	_load_config()

func parse_and_execute(input_line: String) -> void:
	var trimmed = input_line.strip_edges()
	if trimmed.is_empty() or trimmed.begins_with(\"#\") or trimmed.begins_with(\"//\"):
		return

	var tokens = _tokenize(trimmed)
	if tokens.is_empty():
		return

	var command = tokens[0].to_upper()
	var args = tokens.slice(1)

	_execute_command(command, args)

func _tokenize(line: String) -> Array:
	var result = []
	var current = \"\"
	var in_quotes = false

	for i in range(line.length()):
		var c = line[i]
		if c == '\"':
			in_quotes = !in_quotes
		elif c == ' ' and not in_quotes:
			if not current.is_empty():
				result.append(current)
				current = \"\"
		else:
			current += c

	if not current.is_empty():
		result.append(current)

	return result

func _execute_command(cmd: String, args: Array) -> void:
	match cmd:
		\"SYSINFO\", \"INFO\":
			output_produced.emit(\"=== TERMWALL MUNDOX (GravanAOL) ===\")
			output_produced.emit(\"Wersja: \" + config_data.get(\"version\", \"1.0\"))
			output_produced.emit(\"Użytkownik: \" + config_data.get(\"user\", \"root\"))
			output_produced.emit(\"Rejestry: \" + str(registers))

		\"CLR\", \"CLEAR\":
			output_produced.emit(\"__CLEAR__\")

		\"OUT\", \"PRINT\", \"ECHO\":
			var text = \" \".join(args)
			output_produced.emit(_resolve_variables(text))

		\"SET\", \"MOV\":
			if args.size() >= 2:
				registers[args[0]] = args[1]
				output_produced.emit(\"[GravanAOL] Ustawiono %s = %s\" % [args[0], args[1]])
			else:
				error_produced.emit(\"[Błąd] Użycie: SET <nazwa> <wartość>\")

		\"SETPASS\", \"CHPASS\":
			if args.size() >= 2:
				if args[0] == config_data.get(\"password\", \"\"):
					config_data[\"password\"] = args[1]
					_save_config()
					output_produced.emit(\"[TermWall Mundox] Hasło zmienione.\")
				else:
					error_produced.emit(\"[Błąd] Niepoprawne stare hasło.\")
			else:
				error_produced.emit(\"[Błąd] Użycie: SETPASS <stare_hasło> <nowe_hasło>\")

		\"CFGSET\":
			if args.size() >= 2:
				config_data[args[0]] = args[1]
				_save_config()
				output_produced.emit(\"[Config] Zaktualizowano klucz: \" + args[0])
			else:
				error_produced.emit(\"[Błąd] Użycie: CFGSET <klucz> <wartość>\")

		\"CFGSHOW\":
			output_produced.emit(\"[Config Data]: \" + str(config_data))

		\"LS\", \"DIR\":
			var dir = DirAccess.open(\"user://\")
			if dir:
				output_produced.emit(\"--- Zawartość user:// ---\")
				dir.list_dir_begin()
				var file_name = dir.get_next()
				while file_name != \"\":
					output_produced.emit(\" > \" + file_name)
					file_name = dir.get_next()
			else:
				error_produced.emit(\"[Błąd FileSystem] Brak dostępu do user://\")

		\"CAT\", \"READ\":
			if args.size() >= 1:
				var path = _fix_path(args[0])
				if FileAccess.file_exists(path):
					var f = FileAccess.open(path, FileAccess.READ)
					output_produced.emit(f.get_as_text())
					f.close()
				else:
					error_produced.emit(\"[Błąd] Plik nie istnieje: \" + path)
			else:
				error_produced.emit(\"[Błąd] Użycie: CAT <ścieżka>\")

		\"WRITE\", \"EDIT\":
			if args.size() >= 2:
				var path = _fix_path(args[0])
				var content = \" \".join(args.slice(1))
				var f = FileAccess.open(path, FileAccess.WRITE)
				if f:
					f.store_string(content)
					f.close()
					output_produced.emit(\"[FileSystem] Zapisano plik: \" + path)
				else:
					error_produced.emit(\"[Błąd] Nie można zapisać: \" + path)
			else:
				error_produced.emit(\"[Błąd] Użycie: WRITE <ścieżka> <treść>\")

		\"DEL\", \"RM\":
			if args.size() >= 1:
				var path = _fix_path(args[0])
				if FileAccess.file_exists(path):
					DirAccess.remove_absolute(path)
					output_produced.emit(\"[FileSystem] Usunięto plik: \" + path)
				else:
					error_produced.emit(\"[Błąd] Plik nie istnieje: \" + path)
			else:
				error_produced.emit(\"[Błąd] Użycie: DEL <ścieżka>\")

		\"OPENSCENE\", \"LOADSCENE\":
			if args.size() >= 1:
				var scene_path = args[0]
				if ResourceLoader.exists(scene_path):
					output_produced.emit(\"[Mundox] Wczytywanie sceny: \" + scene_path)
					scene_change_requested.emit(scene_path)
				else:
					error_produced.emit(\"[Błąd Sceny] Nie odnaleziono: \" + scene_path)
			else:
				error_produced.emit(\"[Błąd] Użycie: OPENSCENE <ścieżka.tscn>\")

		\"MAKESCENE\", \"ENCODESCENE\":
			if args.size() >= 2:
				var path = _fix_path(args[0])
				var node_name = args[1]
				var tscn_content = '[gd_scene load_steps=1 format=3]\\n\\n[node name=\"%s\" type=\"Node2D\"]\\n' % node_name
				var f = FileAccess.open(path, FileAccess.WRITE)
				if f:
					f.store_string(tscn_content)
					f.close()
					output_produced.emit(\"[Scene Engine] Zakodowano scenę: \" + path)
				else:
					error_produced.emit(\"[Błąd] Brak możliwości utworzenia sceny.\")
			else:
				error_produced.emit(\"[Błąd] Użycie: MAKESCENE <ścieżka.tscn> <NazwaWęzła>\")

		\"GHGET\", \"FETCHRAW\":
			if args.size() >= 2:
				var raw_url = args[0]
				var save_path = _fix_path(args[1])
				output_produced.emit(\"[GitHub Fetcher] Pobieranie: \" + raw_url)
				_download_github_raw(raw_url, save_path)
			else:
				error_produced.emit(\"[Błąd Network] Użycie: GHGET <url> <ścieżka>\")

		\"FIX\", \"REPAIR\":
			output_produced.emit(\"[Repair Engine] Skanowanie spójności...\")
			_load_config()
			output_produced.emit(\" -> Rejestry... [OK]\")
			output_produced.emit(\" -> Konfiguracja... [OK]\")
			output_produced.emit(\"[Repair Engine] System spójny.\")

		_:
			error_produced.emit(\"[Błąd GravanAOL] Nieznana komenda: \" + cmd)

func _resolve_variables(text: String) -> String:
	for reg in registers.keys():
		text = text.replace(\"$\" + reg, str(registers[reg]))
	return text

func _fix_path(path: String) -> String:
	if not path.begins_with(\"user://\") and not path.begins_with(\"res://\"):
		return \"user://\" + path
	return path

func _save_config() -> void:
	var f = FileAccess.open(CONFIG_PATH, FileAccess.WRITE)
	if f:
		f.store_string(JSON.stringify(config_data, \"\\t\"))
		f.close()

func _load_config() -> void:
	if FileAccess.file_exists(CONFIG_PATH):
		var f = FileAccess.open(CONFIG_PATH, FileAccess.READ)
		var json = JSON.new()
		if json.parse(f.get_as_text()) == OK:
			config_data = json.data
		f.close()
	else:
		_save_config()

func _download_github_raw(url: String, save_path: String) -> void:
	var http = HTTPRequest.new()
	add_child(http)
	http.request_completed.connect(
		func(result, response_code, headers, body):
			if response_code == 200:
				var f = FileAccess.open(save_path, FileAccess.WRITE)
				if f:
					f.store_buffer(body)
					f.close()
					output_produced.emit(\"[GitHub Fetcher] Zapisano: \" + save_path)
				else:
					error_produced.emit(\"[Błąd Zapisu] Nie można zapisać pliku.\")
			else:
				error_produced.emit(\"[Błąd HTTP] Kod odpowiedzi: \" + str(response_code))
			http.queue_free()
	)
	var err = http.request(url)
	if err != OK:
		error_produced.emit(\"[Błąd HTTP] Problem z połączeniem.\")
"

[sub_resource type="GDScript" id="GDScript_terminal"]
script/source = "extends Control

# =========================================================
# PROND SHOCK OS — TERMWALL MUNDOX (ZABRA COMPATIBLE)
# Godot 4.x
# =========================================================

@onready var parser = $GravanAOLParser
@onready var output_label: RichTextLabel = $VBoxContainer/RichTextLabel
@onready var input_field: LineEdit = $VBoxContainer/HBoxContainer/LineEdit
@onready var status_label: Label = $VBoxContainer/StatusLabel

func _ready() -> void:
	name = \"TermWallMundox\"

	if parser:
		parser.output_produced.connect(_on_output)
		parser.error_produced.connect(_on_error)
		parser.scene_change_requested.connect(_on_scene_change)

	if input_field:
		input_field.text_submitted.connect(_on_line_submitted)
		input_field.grab_focus()

	_set_status(\"TermWall Mundox gotowy. ZABRA: Połączono.\")

func _set_status(msg: String) -> void:
	if is_instance_valid(status_label):
		status_label.text = msg

func _on_line_submitted(new_text: String) -> void:
	if new_text.strip_edges().is_empty():
		return
	output_label.append_text(\"\\n[color=green]root@mundox:~$ [/color]\" + new_text)
	input_field.clear()
	parser.parse_and_execute(new_text)

func _on_output(text: String) -> void:
	if text == \"__CLEAR__\":
		output_label.text = \"\"
	else:
		output_label.append_text(\"\\n\" + text)

func _on_error(text: String) -> void:
	output_label.append_text(\"\\n[color=red]\" + text + \"[/color]\")

func _on_scene_change(scene_path: String) -> void:
	get_tree().change_scene_to_file(scene_path)
"

[node name="TermWallMundox" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_terminal")

[node name="GravanAOLParser" type="Node" parent="."]
script = SubResource("GDScript_parser")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2

[node name="HeaderLabel" type="Label" parent="VBoxContainer"]
