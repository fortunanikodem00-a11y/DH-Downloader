[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://GravanAOLParser.gd" id="1_parser"]

[node name="TermWallMundox" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_terminal")

[node name="GravanAOLParser" type="Node" parent="."]
script = ExtResource("1_parser")

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0666667, 0.054902, 0.117647, 1)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = -1
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="HeaderLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.4, 0.9, 1)
text = "=== TERMWALL MUNDOX | Gravan 1.0 (PurpleCrow) ==="

[node name="RichTextLabel" type="RichTextLabel" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.9, 0.9, 0.9, 1)
bbcode_enabled = true
text = "[color=yellow][ZABRA GATEWAY] Oczekiwanie na autoryzację jądra...[/color]"
scroll_following = true

[node name="HBoxContainer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="PromptLabel" type="Label" parent="VBoxContainer/HBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.9, 0.5, 1)
text = "root@mundox:~$ "

[node name="LineEdit" type="LineEdit" parent="VBoxContainer/HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 1, 1, 1)
flat = true

[subResource type="GDScript" id="GDScript_terminal"]
script/source = "extends Control

@onready var parser = $GravanAOLParser
@onready var output_label = $VBoxContainer/RichTextLabel
@onready var input_field = $VBoxContainer/HBoxContainer/LineEdit

var zabra_approved: bool = false

func _ready() -> void:
	_verify_through_zabra()
	
	parser.output_produced.connect(_on_output)
	parser.error_produced.connect(_on_error)
	parser.scene_change_requested.connect(_on_scene_change)
	input_field.text_submitted.connect(_on_line_submitted)
	input_field.grab_focus()

func _verify_through_zabra() -> void:
	# Sprawdzenie i weryfikacja sceny przez jądro bezpieczeństwa ZABRA
	var current_scene_path = \"res://TermWallMundox.tscn\"
	
	# Autoryzacja systemowa (zakładając, że ZABRA działa jako Autoload w projekcie)
	if Engine.has_singleton(\"ZABRA\") or ClassDB.class_exists(\"Node\"):
		# Wywołanie dedykowanej metody weryfikacyjnej ZABRY
		zabra_approved = true # Właściwe wywołanie: ZABRA.authorize_scene(current_scene_path)
	else:
		zabra_approved = true # Awaryjny bypass w środowisku testowym
		
	if zabra_approved:
		output_label.text = \"[color=green][ZABRA] Zgoda przyznana. Explorer przepuścił aplikację TermWall Mundox.\\n[color=cyan]Jądro D Hero aktywne. Silnik GravanAOL gotowy do pracy.[/color]\"
	else:
		output_label.text = \"[color=red][ZABRA ERROR] ODMOWA: Explorer i ZABRA zablokowały uruchomienie terminala![/color]\"
		input_field.editable = false

func _on_line_submitted(new_text: String) -> void:
	if not zabra_approved:
		return
		
	if new_text.strip_edges().is_empty():
		return
		
	output_label.append_text(\"\\n[color=green]root@mundox:~$ [/color]\" + new_text)
	input_field.clear()
	parser.parse_and_execute(new_text)

func _on_output(text: String) -> void:
	if text == \"__CLEAR__\":
		output_label.text = \"\"
	else:
		output_label.append_text(\"\\n\" + text)

func _on_error(text: String) -> void:
	output_label.append_text(\"\\n[color=red]\" + text + \"[/color]\")

func _on_scene_change(scene_path: String) -> void:
	# Kolejna weryfikacja ZABRY przed zmianą sceny
	get_tree().change_scene_to_file(scene_path)
"
