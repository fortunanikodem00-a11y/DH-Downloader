anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_terminal")
metadata/zabra_status = "PASSED"
metadata/app_id = "TermWallMundox"
metadata/app_name = "TermWall Mundox"
metadata/publisher = "PROND SHOCK OS - Gravan 1.0"

[node name="GravanAOLParser" type="Node" parent="."]
script = ExtResource("1_parser")

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
