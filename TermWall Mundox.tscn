grow_vertical = 2
theme_override_constants/separation = 10

[node name="HeaderLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.4, 0.9, 1)
text = "=== TERMWALL MUNDOX | Gravan 1.0 (PurpleCrow) ==="

[node name="RichTextLabel" type="RichTextLabel" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.9, 0.9, 0.9, 1)
bbcode_enabled = true
text = "[color=green][ZABRA] Pomyślnie zweryfikowano aplikację: TermWall Mundox. Blokada zdjęta.[/color]\nSystem zainicjalizowany. Jądro D Hero aktywne. Wpisz polecenie..."
scroll_following = true

[node name="HBoxContainer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="PromptLabel" type="Label" parent="VBoxContainer/HBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.9, 0.5, 1)
text = "root@mundox:~$ "

[node name="LineEdit" type="LineEdit" parent="VBoxContainer/HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 1, 1, 1)
flat = true

[subResource type="GDScript" id="GDScript_terminal"]
script/source = "extends Control

@onready var parser = $GravanAOLParser
@onready var output_label = $VBoxContainer/RichTextLabel
@onready var input_field = $VBoxContainer/HBoxContainer/LineEdit

var zabra_approved: bool = false

func _ready() -> void:
	# Weryfikacja aplikacji po nazwie i identyfikatorze w metadanych przez ZABRĘ
	if has_meta(\"app_id\") and get_meta(\"app_id\") == \"TermWall Mundox\" and get_meta(\"zabra_status\") == \"PASSED\":
		zabra_approved = true
	else:
		zabra_approved = false
		output_label.text = \"[color=red][ZABRA ERROR] Zablokowano aplikację: Niezgodny identyfikator TermWall Mundox![/color]\"
		input_field.editable = false
		return

	parser.output_produced.connect(_on_output)
	parser.error_produced.connect(_on_error)
	parser.scene_change_requested.connect(_on_scene_change)
	input_field.text_submitted.connect(_on_line_submitted)
	input_field.grab_focus()

func _on_line_submitted(new_text: String) -> void:
	if not zabra_approved:
		return
		
	if new_text.strip_edges().is_empty():
		return
		
	output_label.append_text(\"\\n[color=green]root@mundox:~$ [/color]\" + new_text)
	input_field.clear()
	parser.parse_and_execute(new_text)

func _on_output(text: String) -> void:
	if text == \"__CLEAR__\":
		output_label.text = \"\"
	else:
		output_label.append_text(\"\\n\" + text)

func _on_error(text: String) -> void:
	output_label.append_text(\"\\n[color=red]\" + text + \"[/color]\")

func _on_scene_change(scene_path: String) -> void:
	get_tree().change_scene_to_file(scene_path)
