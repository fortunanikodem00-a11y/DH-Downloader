[gd_scene load_steps=2 format=3 uid="uid://soundboard_app_embedded"]

[sub_resource type="GDScript" id="GDScript_soundboard"]
script/source = "extends Control

@onready var status_label: Label = $VBoxContainer/StatusLabel
@onready var audio_player: AudioStreamPlayer = $AudioStreamPlayer

func _ready() -> void:
	for btn in $VBoxContainer/GridContainer.get_children():
		if btn is Button:
			btn.pressed.connect(func(): _on_sound_button_pressed(btn.text))
	
	status_label.text = \"Soundboard gotowy. Kliknij przycisk, aby odtworzyć.\"

func _on_sound_button_pressed(sound_name: String) -> void:
	status_label.text = \"Odtwarzam dźwięk: \" + sound_name
	
	# Tworzymy prosty, syntetyczny dźwięk (generator tonu w locie), żeby apka działała od razu bez plików mp3/ogg
	var generator = AudioStreamGenerator.new()
	generator.mix_rate = 22050
	audio_player.stream = generator
	audio_player.play()
	
	# Alternatywnie, jeśli masz plik w user://, możesz użyć:
	# audio_player.stream = load(\"user://twoj_plik.ogg\")
	# audio_player.play()
"

