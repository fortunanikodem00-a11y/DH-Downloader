[gd_scene load_steps=2 format=3 uid="uid://calculator_app_embedded"]

[sub_resource type="GDScript" id="GDScript_calculator"]
script/source = "extends Control

@onready var display: LineEdit = $VBoxContainer/Display

var current_input: String = \"\"

func _ready() -> void:
	display.text = \"0\"
	# Łączymy przyciski z obsługą cyfr i działań
	for btn in $VBoxContainer/GridContainer.get_children():
		if btn is Button:
			btn.pressed.connect(func(): _on_button_pressed(btn.text))

func _on_button_pressed(value: String) -> void:
	match value:
		\"C\":
			current_input = \"\"
			display.text = \"0\"
		\"=\":
			_calculate_result()
		_:
			current_input += value
			display.text = current_input

func _calculate_result() -> void:
	if current_input == \"\":
		return
		
	var expression = Expression.new()
	var err = expression.parse(current_input)
	if err == OK:
		var result = expression.execute()
		if not expression.has_execute_failed():
			display.text = str(result)
			current_input = str(result)
		else:
			display.text = \"Błąd matematyczny\"
			current_input = \"\"
	else:
		display.text = \"Błąd wyrażenia\"
		current_input = \"\"
"

